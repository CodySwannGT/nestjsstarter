      "id": "chief",
      "role": "Chief of Staff",
      "expertise": "Coordinating the digital staff, project state, decisions, playbooks, and open questions across the Thumbwar backend.",
      "owns": {
        "categories": ["projects", "decisions", "playbooks", "open-questions"]
      },
      "sensitivity": "confidential"
    },
    {
      "id": "sally",
      "role": "Sales",
      "expertise": "Sales pipeline, deals, and go-to-market knowledge.",
      "owns": { "categories": ["sales"] },
      "sensitivity": "internal"
    },
    {
      "id": "mark",
      "role": "Marketing",
      "expertise": "Marketing, positioning, and campaigns.",
      "owns": { "categories": ["marketing"] },
